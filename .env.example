# Simulation only. This project does not send mainnet transactions unless you
# deliberately set both of the live-mode switches below. That is not recommended.
#
# ARB_MODE: simulate (default, eth_call only) | fork (local anvil only) | live
ARB_MODE=simulate

# Live mode also requires this exact string. Leave it empty.
ARB_ALLOW_LIVE=

# Read RPCs. Public endpoints are fine. Override with your own if you have them.
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org
ARB_RPC_URL=https://arb1.arbitrum.io/rpc

# Local fork (anvil). Fork mode refuses any non-loopback submit URL.
FORK_RPC_URL=http://127.0.0.1:8545

# Optional overrides for the pinned fork-test blocks in config/fork-blocks.json
# FORK_BLOCK_MAINNET=
# FORK_BLOCK_BASE=
# FORK_BLOCK_ARBITRUM=

# Never put a funded key here. Fork demo uses Anvil's public default account.
# PRIVATE_KEY=

# Mempool monitor. Read-only public websocket. It does not sign or send.
# MEMPOOL_WS is fixed in bot/flasharb/mempool.py. Duration flags:
#   python -m flasharb.mempool --seconds 900 --l2-seconds 45 --grace 90
